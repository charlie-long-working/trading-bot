// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0.
// © RSI Trend Dip — Chỉ giao dịch THEO XU HƯỚNG
// LONG: Uptrend + mua dip (RSI oversold). SHORT: Downtrend + bán đỉnh (RSI overbought).
// Indicator version của RSI_Trend_Dip_Strategy.pine

//@version=5
indicator("RSI Trend Dip - Tín hiệu", overlay=true, max_labels_count=500, max_lines_count=2)

g_trend = "Trend"
i_emaLen = input.int(50, "EMA trend", group=g_trend, minval=20)

g_rsi = "RSI"
i_rsiLen = input.int(14, "RSI length", group=g_rsi, minval=5)
i_rsiOversold = input.int(38, "Oversold", group=g_rsi, minval=25, maxval=45)
i_rsiOverbought = input.int(62, "Overbought", group=g_rsi, minval=55, maxval=75)

g_sltp = "SL / TP"
i_tpPct = input.float(2.5, "TP %", group=g_sltp, minval=1.0, step=0.5)
i_slPct = input.float(1.5, "SL %", group=g_sltp, minval=0.5, step=0.5)

g_filter = "Bộ lọc"
i_minBarsBetween = input.int(5, "Bars giữa 2 lệnh", group=g_filter, minval=0)
i_allowShort = input.bool(true, "Cho phép SHORT", group=g_filter)

g_plot = "Hiển thị"
i_showEMA = input.bool(true, "Vẽ EMA", group=g_plot)
i_showSLTP = input.bool(true, "Vẽ SL/TP", group=g_plot)
i_slTpBars = input.int(30, "SL/TP kéo dài", group=g_plot, minval=5)

ema = ta.ema(close, i_emaLen)
rsi = ta.rsi(close, i_rsiLen)
uptrend = close > ema
downtrend = close < ema

longCondRaw = uptrend and rsi <= i_rsiOversold
shortCondRaw = downtrend and rsi >= i_rsiOverbought

var int lastLongBar = na
var int lastShortBar = na
barsSinceLong = bar_index - nz(lastLongBar, bar_index - 999)
barsSinceShort = bar_index - nz(lastShortBar, bar_index - 999)

longCond = longCondRaw and barsSinceShort >= i_minBarsBetween
shortCond = shortCondRaw and barsSinceLong >= i_minBarsBetween and i_allowShort

if longCond
    lastLongBar := bar_index
if shortCond
    lastShortBar := bar_index

longSl = close * (1 - i_slPct / 100)
longTp = close * (1 + i_tpPct / 100)
shortSl = close * (1 + i_slPct / 100)
shortTp = close * (1 - i_tpPct / 100)

var line slLine = na
var line tpLine = na
var label sigLabel = na

if (longCond or shortCond) and i_showSLTP
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(sigLabel)
        label.delete(sigLabel)
    if longCond
        slLine := line.new(bar_index, longSl, bar_index + i_slTpBars, longSl, color=color.red, width=2)
        line.set_style(slLine, line.style_dashed)
        tpLine := line.new(bar_index, longTp, bar_index + i_slTpBars, longTp, color=color.green, width=2)
        line.set_style(tpLine, line.style_dashed)
        sigLabel := label.new(bar_index, high, "LONG\nSL: " + str.tostring(longSl, "#.##") + "\nTP: " + str.tostring(longTp, "#.##"), style=label.style_label_down, color=color.new(#4CAF50, 20), textcolor=color.white, size=size.small)
    else
        slLine := line.new(bar_index, shortSl, bar_index + i_slTpBars, shortSl, color=color.red, width=2)
        line.set_style(slLine, line.style_dashed)
        tpLine := line.new(bar_index, shortTp, bar_index + i_slTpBars, shortTp, color=color.green, width=2)
        line.set_style(tpLine, line.style_dashed)
        sigLabel := label.new(bar_index, low, "SHORT\nSL: " + str.tostring(shortSl, "#.##") + "\nTP: " + str.tostring(shortTp, "#.##"), style=label.style_label_up, color=color.new(#f44336, 20), textcolor=color.white, size=size.small)

plot(i_showEMA ? ema : na, "EMA", color=color.new(#FF9800, 0), linewidth=2)
plotshape(longCond, "LONG", shape.triangleup, location.belowbar, color.new(#4CAF50, 0), size=size.normal)
plotshape(shortCond, "SHORT", shape.triangledown, location.abovebar, color.new(#f44336, 0), size=size.normal)
bgcolor(uptrend ? color.new(#4CAF50, 95) : color.new(#f44336, 95))

alertcondition(longCond, "RSI Trend Dip - Long", "Tín hiệu LONG")
alertcondition(shortCond, "RSI Trend Dip - Short", "Tín hiệu SHORT")
