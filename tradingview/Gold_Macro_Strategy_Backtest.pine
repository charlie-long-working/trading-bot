//@version=5
// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0.
// Backtest: cùng logic với Gold_Macro_Signals.pine — EMA 20/50/200 stack + lọc DXY/US10Y (tùy chọn).
// Long khi bull stack + macroOk; thoát khi EMA20 cắt xuống EMA50 hoặc đảo stack bear.
// Short tùy chọn khi bear stack + DXY mạnh hơn SMA.
// INIT_CAPITAL phải trùng initial_capital bên dưới (dùng cho % lợi nhuận trên bảng).

INIT_CAPITAL = 10000

strategy(
     "Gold Macro — Strategy Backtest",
     shorttitle="GoldMacroBT",
     overlay=true,
     pyramiding=0,
     process_orders_on_close=true,
     initial_capital=INIT_CAPITAL,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     calc_on_every_tick=false)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

g_ma = "EMA"
i_ema20  = input.bool(true, "Hiện EMA 20", group=g_ma)
i_ema50  = input.bool(true, "Hiện EMA 50", group=g_ma)
i_ema100 = input.bool(true, "Hiện EMA 100", group=g_ma)
i_ema200 = input.bool(true, "Hiện EMA 200", group=g_ma)

g_macro = "Macro (request.security)"
i_symDXY   = input.symbol("TVC:DXY", "DXY", group=g_macro)
i_symUS10Y = input.symbol("TVC:US10Y", "US 10Y", group=g_macro)
i_symFed   = input.symbol("FRED:FEDFUNDS", "Fed funds", group=g_macro)

g_evt = "Sự kiện"
i_showRecession = input.bool(true, "Nền suy thoái (NBER)", group=g_evt)
i_recessionTint = input.color(color.new(color.red, 88), "Màu suy thoái", group=g_evt)
i_showWar = input.bool(true, "Dấu mốc chiến tranh", group=g_evt)
i_warBg = input.bool(false, "Nền vùng chiến tranh", group=g_evt)
i_warTint = input.color(color.new(color.maroon, 92), "Màu nền chiến tranh", group=g_evt)

g_sig = "Tín hiệu & rủi ro"
i_macroFilter = input.bool(true, "Lọc: DXY < SMA", group=g_sig)
i_macroSmaLen = input.int(50, "SMA DXY", group=g_sig, minval=5, maxval=200)
i_yieldFilter = input.bool(false, "Lọc: US10Y < SMA", group=g_sig)
i_yieldSmaLen = input.int(50, "SMA US10Y", group=g_sig, minval=5, maxval=200)
i_allowShort = input.bool(false, "Cho phép SHORT", group=g_sig)
i_exitCross = input.bool(true, "Thoát long khi EMA20 cắt xuống EMA50", group=g_sig)
i_slPct = input.float(0.0, "SL % từ giá vào (0=tắt)", group=g_sig, minval=0.0, step=0.5)
i_tpPct = input.float(0.0, "TP % từ giá vào (0=tắt)", group=g_sig, minval=0.0, step=0.5)

g_stats = "Thống kê lợi nhuận"
i_showStats = input.bool(true, "Hiện thống kê (label, không dùng table)", group=g_stats)
i_statsPos  = input.string("top_right", "Vị trí gần đúng", group=g_stats, options=["top_right", "top_left", "bottom_right", "bottom_left"])

// ═══════════════════════════════════════════════════════════════════════════
// INDICATORS
// ═══════════════════════════════════════════════════════════════════════════

ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

plot(i_ema20  ? ema20  : na,  "EMA 20",  color=color.new(color.teal, 0), linewidth=1)
plot(i_ema50  ? ema50  : na,  "EMA 50",  color=color.new(color.orange, 0), linewidth=2)
plot(i_ema100 ? ema100 : na, "EMA 100", color=color.new(color.purple, 0), linewidth=1)
plot(i_ema200 ? ema200 : na, "EMA 200", color=color.new(color.gray, 0), linewidth=2)

dxyM  = request.security(i_symDXY,   timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
us10M = request.security(i_symUS10Y, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
fedM  = request.security(i_symFed,   timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

dxySma   = ta.sma(dxyM, i_macroSmaLen)
yieldSma = ta.sma(us10M, i_yieldSmaLen)

plot(dxyM,  "DXY (data)", display=display.none)
plot(us10M, "US10Y (data)", display=display.none)
plot(fedM,  "Fed (data)", display=display.none)

// ═══════════════════════════════════════════════════════════════════════════
// Recession / war (same as Signals)
// ═══════════════════════════════════════════════════════════════════════════

f_recession() =>
    t = time
    (t >= timestamp("1969-12-01") and t < timestamp("1970-12-01")) or
     (t >= timestamp("1973-11-01") and t < timestamp("1975-04-01")) or
     (t >= timestamp("1980-01-01") and t < timestamp("1980-08-01")) or
     (t >= timestamp("1981-07-01") and t < timestamp("1982-12-01")) or
     (t >= timestamp("1990-07-01") and t < timestamp("1991-04-01")) or
     (t >= timestamp("2001-03-01") and t < timestamp("2001-12-01")) or
     (t >= timestamp("2007-12-01") and t < timestamp("2009-07-01")) or
     (t >= timestamp("2020-02-01") and t < timestamp("2020-05-01"))

bgcolor(i_showRecession and f_recession() ? i_recessionTint : na)

f_warPeriod() =>
    t = time
    (t >= timestamp("1990-08-02") and t < timestamp("1991-05-01")) or
     (t >= timestamp("1998-03-24") and t < timestamp("1999-06-21")) or
     (t >= timestamp("2001-10-07") and t < timestamp("2015-01-01")) or
     (t >= timestamp("2003-03-20") and t < timestamp("2011-12-16")) or
     (t >= timestamp("2022-02-24") and t < timestamp("2030-12-31"))

bgcolor(i_showWar and i_warBg and f_warPeriod() ? i_warTint : na)

f_edge(cond) => cond and (bar_index == 0 or not cond[1])

gulfStart  = time >= timestamp("1990-08-02") and time < timestamp("1990-09-01")
afgStart   = time >= timestamp("2001-10-07") and time < timestamp("2001-11-01")
iraqStart  = time >= timestamp("2003-03-20") and time < timestamp("2003-04-01")
ukrStart   = time >= timestamp("2022-02-24") and time < timestamp("2022-03-01")
gfcStress  = time >= timestamp("2008-09-15") and time < timestamp("2008-10-01")

plotshape(i_showWar and f_edge(gulfStart), title="Gulf", style=shape.xcross, location=location.abovebar, size=size.tiny, color=color.maroon, text="GW")
plotshape(i_showWar and f_edge(afgStart), title="Afg", style=shape.xcross, location=location.abovebar, size=size.tiny, color=color.maroon, text="AFG")
plotshape(i_showWar and f_edge(iraqStart), title="Iraq", style=shape.xcross, location=location.abovebar, size=size.tiny, color=color.maroon, text="IRQ")
plotshape(i_showWar and f_edge(ukrStart), title="Ukr", style=shape.xcross, location=location.abovebar, size=size.tiny, color=color.maroon, text="UKR")
plotshape(i_showWar and f_edge(gfcStress), title="GFC", style=shape.xcross, location=location.abovebar, size=size.tiny, color=color.gray, text="GFC")

// ═══════════════════════════════════════════════════════════════════════════
// Entries / exits
// ═══════════════════════════════════════════════════════════════════════════

stackBull = ema20 > ema50 and ema50 > ema200
stackBear = ema20 < ema50 and ema50 < ema200

macroOkLong = not i_macroFilter or (not na(dxyM) and dxyM < dxySma)
macroOkShort = not i_macroFilter or (not na(dxyM) and dxyM > dxySma)
yieldOkLong = not i_yieldFilter or (not na(us10M) and us10M < yieldSma)
yieldOkShort = not i_yieldFilter or (not na(us10M) and us10M > yieldSma)

longCond  = stackBull and macroOkLong and yieldOkLong
shortCond = i_allowShort and stackBear and macroOkShort and yieldOkShort

longSignal  = longCond and not longCond[1]
shortSignal = shortCond and not shortCond[1]

exitLong = strategy.position_size > 0 and (stackBear or (i_exitCross and ta.crossunder(ema20, ema50)))
exitShort = strategy.position_size < 0 and (stackBull or (i_exitCross and ta.crossover(ema20, ema50)))

if longSignal
    strategy.close("Short", comment="Cover")
    strategy.entry("Long", strategy.long)

if shortSignal
    strategy.close("Long", comment="Cover")
    strategy.entry("Short", strategy.short)

if exitLong
    strategy.close("Long", comment="Exit L")
if exitShort
    strategy.close("Short", comment="Exit S")

avg = strategy.position_avg_price
longStop  = i_slPct > 0 ? avg * (1.0 - i_slPct / 100.0) : na
longLimit = i_tpPct > 0 ? avg * (1.0 + i_tpPct / 100.0) : na
shortStop  = i_slPct > 0 ? avg * (1.0 + i_slPct / 100.0) : na
shortLimit = i_tpPct > 0 ? avg * (1.0 - i_tpPct / 100.0) : na

strategy.exit("XL", from_entry="Long",  stop=longStop,  limit=longLimit)
strategy.exit("XS", from_entry="Short", stop=shortStop, limit=shortLimit)

// ═══════════════════════════════════════════════════════════════════════════
// Thống kê lợi nhuận — label (không dùng table). strategy.* chỉ được gọi ở phạm vi toàn cục, không trong hàm.
// ═══════════════════════════════════════════════════════════════════════════

f_statsLabelStyle() =>
    switch i_statsPos
        "top_left" => label.style_label_lower_right
        "bottom_right" => label.style_label_upper_left
        "bottom_left" => label.style_label_upper_right
        => label.style_label_lower_left

f_statsTextAlign() =>
    switch i_statsPos
        "top_left" => text.align_right
        "bottom_right" => text.align_left
        "bottom_left" => text.align_right
        => text.align_left

var label statLbl = na
look = math.min(bar_index + 1, 300)
hiBand = ta.highest(high, look)
loBand = ta.lowest(low, look)
yTop = hiBand * 1.002
yBot = loBand * 0.998
yPos = (i_statsPos == "bottom_right" or i_statsPos == "bottom_left") ? yBot : yTop

if barstate.islast
    if i_showStats
        closed = strategy.closedtrades
        won = strategy.wintrades
        lost = strategy.losstrades
        winRate = closed > 0 ? won * 100.0 / closed : na
        gl = strategy.grossloss
        pfStr = gl > 0 ? str.tostring(strategy.grossprofit / gl, "#.##") : "—"
        netPctStr = INIT_CAPITAL > 0 ? str.tostring(strategy.netprofit / INIT_CAPITAL * 100.0, "#.##") : "—"
        avgStr = closed > 0 ? str.tostring(strategy.netprofit / closed, "#.##") : "—"
        ddVsCapStr = INIT_CAPITAL > 0 ? str.tostring(100.0 * strategy.max_drawdown / INIT_CAPITAL, "#.##") : "—"
        wrStr = not na(winRate) ? str.tostring(winRate, "#.#") : "—"
        txt = "THỐNG KÊ\n" +
             "Lợi nhuận ròng: " + str.tostring(strategy.netprofit, "#.##") + " $\n" +
             "LN / vốn: " + netPctStr + "%\n" +
             "Tổng lãi: " + str.tostring(strategy.grossprofit, "#.##") + " $\n" +
             "Tổng lỗ: " + str.tostring(strategy.grossloss, "#.##") + " $\n" +
             "Hệ số LN: " + pfStr + "\n" +
             "Max DD: " + str.tostring(strategy.max_drawdown, "#.##") + " $\n" +
             "DD / vốn: " + ddVsCapStr + "%\n" +
             "Lệnh đóng: " + str.tostring(closed) + "\n" +
             "Thắng / Thua: " + str.tostring(won) + " / " + str.tostring(lost) + "\n" +
             "Tỷ lệ thắng: " + wrStr + "%\n" +
             "LN TB / lệnh: " + avgStr + " $\n" +
             "Equity: " + str.tostring(strategy.equity, "#.##")
        label.delete(statLbl)
        statLbl := label.new(
             bar_index,
             yPos,
             txt,
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=f_statsLabelStyle(),
             color=color.new(color.black, 22),
             textcolor=color.white,
             size=size.small,
             textalign=f_statsTextAlign())
    else if not na(statLbl)
        label.delete(statLbl)
        statLbl := na
