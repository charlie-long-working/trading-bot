# Telegram: báo tín hiệu Long/Short + TP/SL (khung 1h).
# Tạo bot: @BotFather -> /newbot -> dán token vào TELEGRAM_BOT_TOKEN.
# Lấy chat_id: gửi /start cho bot, mở https://api.telegram.org/bot<TOKEN>/getUpdates, tìm "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OKX: bot giao dịch tự động (run_okx_bot.py).
# Tạo API key tại https://www.okx.com/account/my-api (quyền Trade, Read).
# Khi tạo key, OKX bắt bạn nhập "Passphrase" — đó là mật khẩu BẠN TỰ ĐẶT (lưu lại vào OKX_PASSPHRASE).
# OKX chỉ cấp: API Key (OKX_API_KEY) và Secret Key (OKX_SECRET_KEY).
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# OKX_DEMO=1

# FRED (Federal Reserve Economic Data) API key for macroeconomic indicators.
# Get a key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: CoinGlass liquidation map (Professional+). If empty, bot reconstructs
# long/short-by-liq-price from Binance/Bybit/OKX public OI + L/S ratio.
# COINGLASS_API_KEY=

